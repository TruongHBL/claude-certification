#!/usr/bin/env ruby
# frozen_string_literal: true

# `claude` GIẢ cho bài 2.3 (bản CLI). KHÔNG gọi model. Đóng vai Claude Code theo KỊCH BẢN CỐ ĐỊNH để
# kiểm tra đầu-cuối: cờ của run_cli.sh, MCP server thật (stdio), hook thật (sh -c, JSON stdin), audit.
#
# Mô phỏng các hành vi của Claude Code mà bài dựa vào (đã đọc từ docs/types, CHƯA kiểm chứng bằng chạy thật):
#   - mỗi agent chỉ thấy tool trong agents.json[agent].tools; tool khác → "No such tool available" (không qua hook)
#   - hook PreToolUse chạy trước mọi lệnh gọi tool, nhận agent_id/agent_type khi ở subagent
#   - subagent dùng chung MCP server của phiên
# Việc chọn tool là do KỊCH BẢN dưới đây quyết định, không phải hành vi của Claude.

require "json"
require "open3"
require "securerandom"

def flag(name)
  i = ARGV.index(name)
  i && ARGV[i + 1]
end

def abort_usage(msg)
  warn "[claude giả] #{msg}"
  exit 2
end

prompt_i = ARGV.index("-p") || ARGV.index("--print") or abort_usage("thiếu -p")
prompt = ARGV[prompt_i + 1]
%w[--agent --agents --mcp-config --settings --tools --allowedTools --permission-mode --output-format].each do |f|
  abort_usage("thiếu #{f}") unless flag(f)
end
abort_usage("thiếu --strict-mcp-config") unless ARGV.include?("--strict-mcp-config")
abort_usage("stream-json cần --verbose") if flag("--output-format") == "stream-json" && !ARGV.include?("--verbose")
abort_usage("--permission-mode phải là dontAsk") unless flag("--permission-mode") == "dontAsk"
abort_usage("--tools phải chỉ có Agent") unless flag("--tools") == "Agent"

$agents = agents = JSON.parse(File.read(flag("--agents")))
main_agent = flag("--agent")
abort_usage("--agent #{main_agent} không có trong --agents") unless agents.key?(main_agent)
$allowed = flag("--allowedTools").split(/[,\s]+/)
settings = JSON.parse(File.read(flag("--settings")))
$hook_cmds = settings.dig("hooks", "PreToolUse").select { |m| ["*", "", nil].include?(m["matcher"]) }
                    .flat_map { |m| m["hooks"].map { |h| h["command"] } }
mcp = JSON.parse(File.read(flag("--mcp-config")))["mcpServers"]
abort_usage("bài này cần đúng 1 MCP server 'research'") unless mcp.keys == ["research"]

srv = mcp["research"]
SID = "fake-#{SecureRandom.hex(4)}"
$stdout.sync = true
def emit(h) = puts(JSON.generate(h.merge(session_id: SID)))

# ---- MCP client tối thiểu ----
$sin, $sout, _serr, _thr = Open3.popen3(srv["env"] || {}, srv["command"], *srv["args"])
@rpc_id = 0
def rpc(method, params = {})
  $sin.puts(JSON.generate(jsonrpc: "2.0", id: (@rpc_id += 1), method: method, params: params))
  JSON.parse($sout.gets)
end
rpc("initialize", protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "fake-claude" })
$sin.puts(JSON.generate(jsonrpc: "2.0", method: "notifications/initialized"))
mcp_tools = rpc("tools/list").dig("result", "tools").map { |t| "mcp__research__#{t['name']}" }

emit(type: "system", subtype: "init", fake: true, model: flag("--model"), agents: agents.keys,
     tools: (["Agent"] + mcp_tools) & agents[main_agent]["tools"], mcp_servers: [{ name: "research", status: "connected" }])

@turns = 0
@seq = 0
def next_id = "toolu_fake_#{@seq += 1}"

# Chạy hook thật. Trả [deny?, reason]
def run_hooks(tool_name, input, agent_name, agent_id)
  payload = { session_id: SID, transcript_path: "/dev/null", cwd: Dir.pwd, hook_event_name: "PreToolUse",
              permission_mode: "dontAsk", tool_name: tool_name, tool_input: input, agent_type: agent_name }
  payload[:agent_id] = agent_id if agent_id
  $hook_cmds.each do |cmd|
    out, st = Open3.capture2("sh", "-c", cmd, stdin_data: JSON.generate(payload))
    return [true, "hook exit #{st.exitstatus}"] if st.exitstatus == 2
    next if out.strip.empty?

    o = JSON.parse(out)
    if o.dig("hookSpecificOutput", "permissionDecision") == "deny"
      return [true, o.dig("hookSpecificOutput", "permissionDecisionReason")]
    end
  end
  [false, nil]
end

# Thực hiện 1 lệnh gọi tool như Claude Code: kiểm agent có tool không → hook → quyền → thực thi.
def call(agent_name, agent_id, parent, short, input, &sub)
  name = short == "Agent" ? "Agent" : "mcp__research__#{short}"
  id = next_id
  @turns += 1
  emit(type: "assistant", parent_tool_use_id: parent,
       message: { id: "msg_#{id}", role: "assistant", stop_reason: "tool_use",
                  content: [{ type: "tool_use", id: id, name: name, input: input }] })
  text, is_err =
    if !$agents[agent_name]["tools"].include?(name)
      ["<tool_use_error>Error: No such tool available: #{name}</tool_use_error>", true]
    elsif (d = run_hooks(name, input, agent_name, agent_id))[0]
      [d[1], true]
    elsif !$allowed.include?(name)
      ["Permission to use #{name} has been denied (dontAsk).", true]
    elsif name == "Agent"
      [sub.call(id), false]
    else
      r = rpc("tools/call", name: short, arguments: input)
      r["error"] ? [r["error"]["message"], true] : [r.dig("result", "content", 0, "text"), r.dig("result", "isError") == true]
    end
  emit(type: "user", parent_tool_use_id: parent,
       message: { role: "user", content: [{ type: "tool_result", tool_use_id: id, content: text, is_error: is_err }] })
  [text, is_err]
end

GSO = "https://www.gso.gov.vn/bao-cao-lao-dong-2026.pdf"
ILO = "https://www.ilo.org/hybrid-work-asia-2025.pdf"
COMPLEX = "Hybrid làm tăng năng suất 4–7% so với làm toàn thời gian tại văn phòng ở Việt Nam"
misuse = agents.dig("synthesis", "tools").include?("mcp__research__search_web")

SCRIPTS = {
  "web-search" => [
    ["search_web", { query: "hybrid năng suất văn phòng Việt Nam 2026" }],
    ["load_document", { url: "https://www.gso.gov.vn/images/hybrid-chart.png" }],
    ["load_document", { url: GSO }],
    ["load_document", { url: ILO }],
    ["save_snippet", { url: GSO, quote: "62% doanh nghiệp văn phòng áp dụng hybrid", location: "tr. 14" }],
    ["save_snippet", { url: ILO, quote: "năng suất tự đánh giá tăng 4–7% với hybrid 2–3 ngày", location: "p. 31" }]
  ],
  "doc-analysis" => [
    ["extract_data_points", { document_id: "doc-gso", topic: "hybrid" }], # cố ý sai thứ tự → cổng hook chặn
    ["extract_metadata", { document_id: "doc-gso" }],
    ["extract_data_points", { document_id: "doc-gso", topic: "hybrid" }],
    ["extract_metadata", { document_id: "doc-ilo" }],
    ["extract_data_points", { document_id: "doc-ilo", topic: "năng suất" }],
    ["summarize_content", { document_id: "doc-ilo" }]
  ],
  "doc-analysis-verify" => [
    ["extract_metadata", { document_id: "doc-ilo" }],
    ["verify_claim", { claim: COMPLEX, document_ids: %w[doc-gso doc-ilo] }]
  ],
  "synthesis" => [
    ["verify_fact", { fact: "Tỉ lệ doanh nghiệp văn phòng áp dụng hybrid năm 2026 là 62%", source_url: GSO }],
    ["verify_fact", { fact: COMPLEX, source_url: ILO }],
    *(misuse ? [["search_web", { query: "nguồn bổ sung hybrid" }]] : []),
    ["format_citation", { author: "ILO", year: "2025", title: "Hybrid Work in Asia-Pacific 2025", url: ILO }],
    ["compile_report", { title: "Hybrid và năng suất văn phòng VN 2026",
                         sections: [{ heading: "Mức độ phổ biến", body: "62% doanh nghiệp văn phòng áp dụng hybrid.",
                                      citations: [GSO] }],
                         needs_coordinator_verification: [COMPLEX] }]
  ]
}.freeze

run_sub = lambda do |cli_name, script_key, parent|
  agent_id = "agent_#{SecureRandom.hex(3)}"
  SCRIPTS.fetch(script_key).each { |short, input| call(cli_name, agent_id, parent, short, input) }
  "[#{cli_name}] xong (kịch bản giả)"
end

coord = [
  ["web-search", "web-search", "Tìm nguồn: #{prompt}"],
  ["doc-analysis", "doc-analysis", "Phân tích doc-gso, doc-ilo"],
  ["synthesis", "synthesis", "Viết báo cáo từ các số liệu đã có"],
  ["doc-analysis", "doc-analysis-verify", "Kiểm chứng: #{COMPLEX}"]
]
coord.each do |sub, key, p|
  call(main_agent, nil, nil, "Agent", { subagent_type: sub, description: key, prompt: p }) { |id| run_sub.call(sub, key, id) }
end
call(main_agent, nil, nil, "review_output", { agent_type: "synthesis", verdict: "pass", reason: "đủ nguồn" })

$sin.close
emit(type: "result", subtype: "success", is_error: false, num_turns: @turns, total_cost_usd: 0.0,
     result: "[claude giả] Báo cáo: 62% doanh nghiệp áp dụng hybrid (GSO); mức tăng năng suất 4–7% chỉ là tự đánh giá (ILO).")
