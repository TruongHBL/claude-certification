#!/usr/bin/env ruby
# frozen_string_literal: true
# CLAUDE GIẢ nói giao thức stream-json của Agent SDK, để test run_cli.sh / bai_1_3_context_passing.ts.
# KHÔNG gọi model. Luồng coordinator → 2 subagent song song → synthesizer là KỊCH BẢN CỐ ĐỊNH (GIẢ ĐỊNH).
# Cái được kiểm tra THẬT: SDK spawn đúng binary (CLAUDE_BIN), env không có ANTHROPIC_API_KEY, SDK gửi
# định nghĩa agents + JSON schema, và code verify() của bài đọc đúng stream message thật từ SDK.
require "json"
require "securerandom"

if ARGV[0, 2] == %w[auth status]
  puts JSON.generate({ loggedIn: true, authMethod: "fake" })
  exit 0
end
$stdout.sync = true
LOG = ENV["FAKE_SDK_LOG"] ? File.open(ENV["FAKE_SDK_LOG"], "a").tap { _1.sync = true } : nil
def log(h) = LOG&.puts(JSON.generate(h))
def out(h) = $stdout.puts(JSON.generate(h))
log(argv: ARGV, has_api_key: ENV.key?("ANTHROPIC_API_KEY"), self: $PROGRAM_NAME)

S = SecureRandom.uuid
def asst(id, block, parent = nil) = out(type: "assistant", session_id: S, parent_tool_use_id: parent, message: { id: id, role: "assistant", content: [block] })
def result_for(tid, text, parent = nil) = out(type: "user", session_id: S, parent_tool_use_id: parent, message: { role: "user", content: [{ type: "tool_result", tool_use_id: tid, content: text }] })
def agent(id, type, prompt) = { type: "tool_use", id: id, name: "Agent", input: { description: type, subagent_type: type, prompt: prompt } }

FINDINGS = [
  { id: "W1", claim: "Làm từ xa tăng năng suất cá nhân ở tác vụ tập trung", analysis: "Phù hợp code/review", source_type: "web",
    source_url: "https://example.org/study-2025", document_name: nil, page_number: nil, confidence: "medium" },
  { id: "D1", claim: "68% nhân viên thấy focus time tăng khi ở nhà", analysis: "Khớp W1", source_type: "document",
    source_url: nil, document_name: "khao-sat-noi-bo-2026.md", page_number: 2, confidence: "high" },
].freeze
REPORT = { summary: "(GIẢ) Hybrid giúp tập trung hơn.", claims: [
  { statement: "Làm ở nhà giúp tập trung hơn", finding_ids: %w[W1 D1], citation: "https://example.org/study-2025; khao-sat-noi-bo-2026.md, tr. 2" },
] }.freeze

while (l = $stdin.gets)
  m = JSON.parse(l)
  if m["type"] == "control_request"
    req = m["request"]
    log(initialize: { agents: (req["agents"] || {}).keys, has_json_schema: !req["jsonSchema"].nil? }) if req["subtype"] == "initialize"
    out(type: "control_response", response: { subtype: "success", request_id: m["request_id"], response: {} })
  elsif m["type"] == "user"
    out(type: "system", subtype: "init", session_id: S, model: "fake", tools: %w[Task WebSearch WebFetch Read Grep Glob])
    # 2 Agent call trong CÙNG response msg_1 → song song
    asst("msg_1", { type: "text", text: "(GIẢ) Giao song song cho 2 subagent." })
    asst("msg_1", agent("tu_w", "web-researcher", "Câu hỏi: ... Trả JSON findings."))
    asst("msg_1", agent("tu_d", "doc-analyst", "Câu hỏi: ... Chỉ đọc bai_1_3_docs."))
    asst("sub_w", { type: "tool_use", id: "tu_ws", name: "WebSearch", input: { query: "hybrid productivity" } }, "tu_w")
    result_for("tu_w", JSON.generate([FINDINGS[0]]))
    result_for("tu_d", JSON.generate([FINDINGS[1]]))
    asst("msg_2", agent("tu_s", "synthesizer", "Câu hỏi...\n<findings>#{JSON.generate(FINDINGS)}</findings>"))
    result_for("tu_s", JSON.generate(REPORT))
    out(type: "result", subtype: "success", is_error: false, result: JSON.generate(REPORT), structured_output: REPORT,
        session_id: S, num_turns: 3, duration_ms: 1, duration_api_ms: 0, total_cost_usd: 0, usage: {}, uuid: SecureRandom.uuid)
    break
  end
end
